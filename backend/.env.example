# Database Connection (PostgreSQL connection string)
# Note: For Supabase in production, please use port 6543 with transactional pooler query parameters (?pgbouncer=true)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication Security
JWT_SECRET=your_jwt_signing_secret_key_minimum_32_characters
