# Database Connection (Supabase PostgreSQL Connection Pool - transactional pooling recommended)
DATABASE_URL=postgresql://postgres.your-supabase-db-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication Security
JWT_SECRET=your_high_entropy_production_jwt_secret_please_rotate
