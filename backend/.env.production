# Database Connection (Production Supabase / Managed PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ascendiq

# Server Configuration
PORT=5000
NODE_ENV=production

# Authentication Security
JWT_SECRET=your_high_entropy_production_jwt_secret_please_rotate

# Optional Tuning
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=2000
